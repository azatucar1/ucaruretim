# Yerel demoda API ile aynı moda ayarlayın.
VITE_DEMO_MODE=true

# Production Supabase Auth için yalnızca public anon key girilir.
# service_role anahtarı asla VITE_ ile başlayan değişkenlerde tutulmaz.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Yerel geliştirmede boş bırakın (Vite /api isteklerini API'ye yönlendirir).
VITE_API_URL=
