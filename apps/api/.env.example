# Lokal deneme için true. Üretimde false olmalı.
DEMO_MODE=true
PORT=4000
CORS_ORIGIN=http://localhost:5173

# DEMO_MODE=false olduğunda doldurun.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gerçek servis endpoint ve cevap eşleştirmesi Uyumsoft ile doğrulanacak.
# Buraya onaylanmış endpoint'i ve gerekirse sunucu tarafı token'ı girin.
UYUMSOFT_INSIGHT_URL=
UYUMSOFT_API_TOKEN=

# 30 günlük satış adedine göre HIZ sınıflaması (öncelikten bağımsız).
GREEN_MIN_SALES_30D=30
YELLOW_MIN_SALES_30D=10
TARGET_STOCK_DAYS=30

# Gerçek Uyumsoft verileri doğrulanmadan false kalmalı.
AUTO_APPROVE_GREEN=false
